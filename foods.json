 "safetyNotes": {"honey": {"tier": "wait12", "reason": "Honey can cause infant botulism, a severe food poisoning. This includes raw, pasteurized and baked-in honey.", "tip": "Wait until her 1st birthday. Check labels on cereals, yogurts and baked goods.", "source": "cdc_avoid"}, "cowmilk_drink": {"tier": "wait12", "reason": "As a drink, cow's milk can cause intestinal bleeding and has too much protein and minerals for infant kidneys.", "tip": "Fine in cooking and as yogurt or cheese. Offer as a drink from 12 months.", "source": "cdc_avoid"}, "soymilk_drink": {"tier": "wait12", "reason": "Fortified soy drinks shouldn't replace breast milk or formula before 12 months.", "tip": "Small amounts in cooking are fine. Offer as a drink from 12 months.", "source": "dga_babies"}, "plantmilk_drink": {"tier": "wait12", "reason": "Plant-based drinks shouldn't replace breast milk or formula before 12 months.", "tip": "Small amounts in cooking are fine. Offer as a drink from 12 months.", "source": "nhs_avoid"}, "juice": {"tier": "wait12", "reason": "No fruit or vegetable juice before 12 months.", "tip": "Offer the whole fruit instead. After 12 months, 4 oz or less of 100% juice a day.", "source": "cdc_avoid"}, "choke_round": {"tier": "caution", "reason": "Round, firm shape can block a baby's airway.", "tip": "Never serve whole. Quarter lengthwise or flatten; remove any pits.", "source": "cdc_choking"}, "choke_berry": {"tier": "caution", "reason": "Whole round berries can block a baby's airway.", "tip": "Flatten or smash each berry; quarter large ones.", "source": "cdc_choking"}, "choke_hard_raw": {"tier": "caution", "reason": "Hard raw pieces are difficult to chew and easy to choke on.", "tip": "Cook until soft enough to squish between fingers, or grate finely.", "source": "cdc_choking"}, "choke_corn": {"tier": "caution", "reason": "Whole kernels, cooked or raw, are a choking hazard.", "tip": "Offer on the cob to gnaw, or mash/blend the kernels.", "source": "cdc_choking"}, "choke_dried": {"tier": "caution", "reason": "Uncooked dried fruit is small, sticky and chewy.", "tip": "Chop finely, or soak/cook until soft and plump.", "source": "cdc_choking"}, "choke_nut": {"tier": "caution", "reason": "Whole or chopped nuts, and spoonfuls of nut butter, are choking hazards.", "tip": "Serve finely ground, or as smooth butter thinned into food or spread thinly.", "source": "cdc_choking"}, "choke_seed": {"tier": "caution", "reason": "Whole seeds and thick spoonfuls of seed butter are choking hazards.", "tip": "Serve ground, or as seed butter / tahini thinned or spread thinly.", "source": "cdc_choking"}, "choke_tube": {"tier": "caution", "reason": "Tube shape and firm texture can plug a baby's airway.", "tip": "Best avoided. If served, cut lengthwise into thin strips, then into small pieces.", "source": "cdc_choking"}, "choke_meat_chunk": {"tier": "caution", "reason": "Tough or large chunks of meat are hard to chew.", "tip": "Shred or mince, or offer large soft strips to gnaw.", "source": "cdc_choking"}, "choke_cheese_chunk": {"tier": "caution", "reason": "Large chunks of cheese, especially string cheese, are choking hazards.", "tip": "Shred, grate or slice thin.", "source": "cdc_choking"}, "choke_bean": {"tier": "caution", "reason": "Whole beans can be a choking hazard.", "tip": "Mash or flatten each bean.", "source": "cdc_choking"}, "choke_snack": {"tier": "caution", "reason": "Hard, crunchy snack foods are easy to choke on.", "tip": "Best avoided for now.", "source": "cdc_choking"}, "choke_kernel": {"tier": "caution", "reason": "Whole cooked grain kernels can be a choking hazard.", "tip": "Cook very soft and mash, or mix into a sticky food.", "source": "cdc_choking"}, "choke_wheatgerm": {"tier": "caution", "reason": "Plain wheat germ is on the CDC choking list.", "tip": "Stir into moist foods; don't serve it plain.", "source": "cdc_choking"}, "choke_bones": {"tier": "caution", "reason": "Fish bones are a choking hazard.", "tip": "Remove bones carefully; mash any soft canned bones.", "source": "cdc_choking"}, "fish_avoid": {"tier": "caution", "reason": "Highest in mercury. FDA/EPA advise not feeding this fish to children.", "tip": "Choose a 'Best Choice' fish like salmon, cod or sardines instead.", "source": "fda_fish"}, "fish_good": {"tier": "caution", "reason": "Higher in mercury than 'Best Choices' fish (on FDA/EPA's 'Good Choices' list).", "tip": "Serve less often; favor 'Best Choices' fish.", "source": "fda_fish"}, "arsenic": {"tier": "caution", "reason": "Rice tends to contain more inorganic arsenic than other grains.", "tip": "Serve rice as one grain among many; oat, barley and multigrain cereals are alternatives.", "source": "fda_arsenic"}, "unpasteurized": {"tier": "caution", "reason": "Unpasteurized (raw) milk products can carry harmful bacteria.", "tip": "Buy only versions labeled pasteurized.", "source": "cdc_avoid"}, "raw_egg": {"tier": "caution", "reason": "Raw or undercooked egg can carry harmful bacteria.", "tip": "Cook until both white and yolk are firm.", "source": "iowa_raw"}, "raw_shellfish": {"tier": "caution", "reason": "Raw or undercooked shellfish can carry harmful bacteria.", "tip": "Serve only fully cooked; never raw.", "source": "iowa_raw"}, "added_sugar": {"tier": "caution", "reason": "Added sugar: CDC advises none before age 2.", "tip": "Use sparingly, if at all.", "source": "cdc_avoid"}},
